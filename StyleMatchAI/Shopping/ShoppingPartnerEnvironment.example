# StyleMatch Pro shopping runtime configuration example.
#
# The iOS app should receive only clean catalog and redirect endpoints.
# Affiliate IDs, retailer API keys, tracking templates, and network secrets
# belong only in the backend/Cloudflare Worker secret store.

STYLEMATCH_REMOTE_CATALOG_URL=https://stylematch-affiliate-proxy.sabastine-7000.workers.dev/v1/products
STYLEMATCH_SUPPORTED_STORES_URL=https://stylematch-affiliate-proxy.sabastine-7000.workers.dev/v1/stores
STYLEMATCH_PROXY_BASE_URL=https://stylematch-affiliate-proxy.sabastine-7000.workers.dev

# Backend-only secret examples. Do not copy these into the iOS app, app bundle,
# client-side xcconfig files, or public runtime JSON.
CLOUDFLARE_SECRET_BESTBUY_API_KEY=
CLOUDFLARE_SECRET_AFFILIATE_NIKE_ID=
CLOUDFLARE_SECRET_AFFILIATE_MACYS_ID=
CLOUDFLARE_SECRET_AFFILIATE_BESTBUY_ID=
CLOUDFLARE_SECRET_AFFILIATE_TARGET_ID=
CLOUDFLARE_SECRET_AFFILIATE_WALMART_ID=
CLOUDFLARE_SECRET_AFFILIATE_AMAZON_TAG=
CLOUDFLARE_SECRET_AFFILIATE_ADIDAS_ID=
CLOUDFLARE_SECRET_AFFILIATE_HM_ID=
CLOUDFLARE_SECRET_AFFILIATE_ZARA_ID=
CLOUDFLARE_SECRET_AFFILIATE_NORDSTROM_ID=
CLOUDFLARE_SECRET_AFFILIATE_SHEIN_ID=
CLOUDFLARE_SECRET_AFFILIATE_FASHIONNOVA_ID=
CLOUDFLARE_SECRET_AFFILIATE_FOOTLOCKER_ID=
CLOUDFLARE_SECRET_AFFILIATE_DICKS_ID=
CLOUDFLARE_SECRET_AFFILIATE_SEPHORA_ID=
CLOUDFLARE_SECRET_AFFILIATE_ULTA_ID=
